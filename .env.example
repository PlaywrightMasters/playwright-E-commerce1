# Copy to .env to override defaults. Every value is optional.

# Port for the bundled demo shop (started automatically by Playwright).
PORT=3100

# Set to test an already-running deployment instead of starting the demo shop.
# BASE_URL=http://127.0.0.1:3100

# Seeded demo account. The server and the tests both read these, so keep them in sync.
# DEMO_USER_EMAIL=shopper@example.test
# DEMO_USER_PASSWORD=Shopper#2026
